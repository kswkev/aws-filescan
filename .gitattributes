# Normalise text files in the repository; pin line endings where the shell cares.
* text=auto

# bash fails on CRLF ($'\r': command not found), even in Git Bash on Windows.
*.sh  text eol=lf

# cmd.exe can mis-handle labels/goto in LF-only batch files.
*.bat text eol=crlf
*.cmd text eol=crlf

*.ps1 text eol=crlf
