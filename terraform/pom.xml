<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.filescan</groupId>
        <artifactId>aws-filescan</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>terraform</artifactId>
    <packaging>pom</packaging>
    <name>AWS FileScan :: Terraform</name>
    <description>Infrastructure for the emulator. Deployed only with -Pdeploy.</description>

    <!--
        Normal builds do nothing here. To deploy (emulator env must be loaded first):
            . .\scripts\emulator-env.ps1
            mvn -Pdeploy install
    -->
    <profiles>
        <profile>
            <id>deploy</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>terraform-init</id>
                                <phase>install</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${terraform.executable}</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>init</argument>
                                        <argument>-input=false</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>terraform-apply</id>
                                <phase>install</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${terraform.executable}</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>apply</argument>
                                        <argument>-input=false</argument>
                                        <argument>-auto-approve</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
